@@ -0,0 +1,40 @@
+package forge.gamemodes.match.input;
+
+import java.io.Serializable;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Explicit response to one ExternalDecisionRequest. */
+public final class ExternalDecisionResponse implements Serializable {
+    private static final long serialVersionUID = 1L;
+
+    private final long decisionId;
+    private final long token;
+    private final int actorId;
+    private final int principalId;
+    private final String responseSchema;
+    private final List<String> selectedOptionIds;
+    private final boolean cancel;
+
+    public ExternalDecisionResponse(final long decisionId, final long token, final int actorId,
+                                    final int principalId, final String responseSchema,
+                                    final List<String> selectedOptionIds, final boolean cancel) {
+        this.decisionId = decisionId;
+        this.token = token;
+        this.actorId = actorId;
+        this.principalId = principalId;
+        this.responseSchema = responseSchema;
+        this.selectedOptionIds = selectedOptionIds == null
+                ? null : Collections.unmodifiableList(new ArrayList<>(selectedOptionIds));
+        this.cancel = cancel;
+    }
+
+    public long getDecisionId() { return decisionId; }
+    public long getToken() { return token; }
+    public int getActorId() { return actorId; }
+    public int getPrincipalId() { return principalId; }
+    public String getResponseSchema() { return responseSchema; }
+    public List<String> getSelectedOptionIds() { return selectedOptionIds; }
+    public boolean isCancel() { return cancel; }
+}
diff --git a/forge-gui/src/main/java/forge/gamemodes/match/input/ExternalDecisionValidationException.java b/forge-gui/src/main/java/forge/gamemodes/match/input/ExternalDecisionValidationException.java
