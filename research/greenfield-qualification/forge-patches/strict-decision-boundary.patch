@@ -0,0 +1,11 @@
+package forge.gamemodes.match.input;
+
+/**
+ * Supplies an explicit response for a server-owned decision.  Implementations
+ * must not infer legal options; the request is already the authoritative option
+ * set produced by the active Forge input.
+ */
+@FunctionalInterface
+public interface ExternalDecisionProvider {
+    ExternalDecisionResponse decide(ExternalDecisionRequest request);
+}
diff --git a/forge-gui/src/main/java/forge/gamemodes/match/input/ExternalDecisionRequest.java b/forge-gui/src/main/java/forge/gamemodes/match/input/ExternalDecisionRequest.java
new file mode 100644
index 00000000..0238a4c3
--- /dev/null
+++ b/forge-gui/src/main/java/forge/gamemodes/match/input/ExternalDecisionRequest.java
@@ -0,0 +1,146 @@
+package forge.gamemodes.match.input;
+
+import forge.game.GameEntity;
+import forge.game.card.Card;
+import forge.game.player.Player;
+
+import java.io.Serializable;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Immutable, principal-scoped description of one authoritative Forge input.
+ * No prompt text, full GameView, CardView, or hidden card payload is carried by
+ * this contract.
+ */
+public final class ExternalDecisionRequest implements Serializable {
+    private static final long serialVersionUID = 1L;
+
+    public static final String RESPONSE_SCHEMA = "commander-simulator-next.entity-selection.v1";
+    public static final String VISIBILITY_PRINCIPAL_ONLY = "PRINCIPAL_ONLY";
+
+    private final long decisionId;
+    private final long token;
+    private final String decisionKind;
+    private final int actorId;
+    private final int principalId;
+    private final String visibilityScope;
+    private final List<Option> options;
+    private final int minimumSelection;
+    private final int maximumSelection;
+    private final boolean cancelAllowed;
+    private final Map<String, String> constraints;
+    private final String responseSchema;
+    private final Map<String, String> semanticContext;
+
+    public ExternalDecisionRequest(final long decisionId, final long token, final String decisionKind,
+                                   final int actorId, final int principalId, final String visibilityScope,
+                                   final List<Option> options, final int minimumSelection,
+                                   final int maximumSelection, final boolean cancelAllowed,
+                                   final Map<String, String> constraints, final String responseSchema,
+                                   final Map<String, String> semanticContext) {
+        if (decisionId < 1 || token < 1) {
+            throw new IllegalArgumentException("decision id and token must be positive");
+        }
+        if (isBlank(decisionKind) || isBlank(visibilityScope) || isBlank(responseSchema)) {
+            throw new IllegalArgumentException("decision kind, visibility scope, and response schema are required");
+        }
+        if (actorId < 0 || principalId < 0) {
+            throw new IllegalArgumentException("actor and principal ids must be non-negative");
+        }
+        if (options == null || minimumSelection < 0 || maximumSelection < minimumSelection
+                || maximumSelection > options.size()) {
+            throw new IllegalArgumentException("invalid exact option set or selection bounds");
+        }
+        final List<Option> copy = new ArrayList<>(options);
+        for (int i = 0; i < copy.size(); i++) {
+            final Option option = copy.get(i);
+            if (option == null) {
+                throw new IllegalArgumentException("decision option cannot be null");
+            }
+            for (int j = 0; j < i; j++) {
+                if (copy.get(j).getOptionId().equals(option.getOptionId())) {
+                    throw new IllegalArgumentException("decision option ids must be unique");
+                }
+            }
+        }
+        this.decisionId = decisionId;
+        this.token = token;
+        this.decisionKind = decisionKind;
+        this.actorId = actorId;
+        this.principalId = principalId;
+        this.visibilityScope = visibilityScope;
+        this.options = Collections.unmodifiableList(copy);
+        this.minimumSelection = minimumSelection;
+        this.maximumSelection = maximumSelection;
+        this.cancelAllowed = cancelAllowed;
+        this.constraints = Collections.unmodifiableMap(new LinkedHashMap<>(constraints == null
+                ? Collections.emptyMap() : constraints));
+        this.responseSchema = responseSchema;
+        if (semanticContext == null) {
+            throw new IllegalArgumentException("semantic context is required");
+        }
+        this.semanticContext = Collections.unmodifiableMap(new LinkedHashMap<>(semanticContext));
+    }
+
+    public static String optionIdFor(final GameEntity entity) {
+        if (entity == null) {
+            throw new IllegalArgumentException("entity cannot be null");
+        }
+        final String kind = entity instanceof Player ? "player" : entity instanceof Card ? "card" : "entity";
+        return kind + ":" + entity.getId();
+    }
+
+    public static String optionKindFor(final GameEntity entity) {
+        if (entity instanceof Player) return "PLAYER";
+        if (entity instanceof Card) return "CARD";
+        return "ENTITY";
+    }
+
+    private static boolean isBlank(final String value) {
+        return value == null || value.trim().isEmpty();
+    }
+
+    public long getDecisionId() { return decisionId; }
+    public long getToken() { return token; }
+    public String getDecisionKind() { return decisionKind; }
+    public int getActorId() { return actorId; }
+    public int getPrincipalId() { return principalId; }
+    public String getVisibilityScope() { return visibilityScope; }
+    public List<Option> getOptions() { return options; }
+    public int getMinimumSelection() { return minimumSelection; }
+    public int getMaximumSelection() { return maximumSelection; }
+    public boolean isCancelAllowed() { return cancelAllowed; }
+    public Map<String, String> getConstraints() { return constraints; }
+    public String getResponseSchema() { return responseSchema; }
+    public Map<String, String> getSemanticContext() { return semanticContext; }
+
+    public static final class Option implements Serializable {
+        private static final long serialVersionUID = 1L;
+        private final String optionId;
+        private final String entityKind;
+        private final int entityId;
+
+        public Option(final String optionId, final String entityKind, final int entityId) {
+            if (isBlank(optionId) || isBlank(entityKind) || entityId < 0) {
+                throw new IllegalArgumentException("option id, entity kind, and entity id are required");
+            }
+            final String normalizedKind = entityKind.trim().toUpperCase(Locale.ROOT);
+            final String expectedOptionId = normalizedKind.toLowerCase(Locale.ROOT) + ":" + entityId;
+            if (!expectedOptionId.equals(optionId)) {
+                throw new IllegalArgumentException("option id must be type-qualified by entity kind and id");
+            }
+            this.optionId = optionId;
+            this.entityKind = normalizedKind;
+            this.entityId = entityId;
+        }
+
+        public String getOptionId() { return optionId; }
+        public String getEntityKind() { return entityKind; }
+        public int getEntityId() { return entityId; }
+    }
+}
