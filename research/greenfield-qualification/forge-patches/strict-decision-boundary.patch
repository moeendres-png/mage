@@ -0,0 +1,28 @@
+package forge.gamemodes.match.input;
+
+/** A response was rejected without applying a selection to the active input. */
+public final class ExternalDecisionValidationException extends RuntimeException {
+    public enum Code {
+        MISSING_RESPONSE,
+        NULL_RESPONSE,
+        MALFORMED_RESPONSE,
+        STALE_RESPONSE,
+        WRONG_ACTOR,
+        WRONG_PRINCIPAL,
+        ILLEGAL_OPTION,
+        INVALID_SELECTION_COUNT,
+        CANCEL_NOT_ALLOWED,
+        DECISION_CONSUMED,
+        TIMEOUT,
+        UNSUPPORTED_DECISION_PATH
+    }
+
+    private final Code code;
+
+    public ExternalDecisionValidationException(final Code code, final String message) {
+        super(code + ": " + message);
+        this.code = code;
+    }
+
+    public Code getCode() { return code; }
+}
diff --git a/forge-gui/src/main/java/forge/gamemodes/match/input/ExternalDecisionValidator.java b/forge-gui/src/main/java/forge/gamemodes/match/input/ExternalDecisionValidator.java
new file mode 100644
index 00000000..16d99799
--- /dev/null
+++ b/forge-gui/src/main/java/forge/gamemodes/match/input/ExternalDecisionValidator.java
@@ -0,0 +1,85 @@
+package forge.gamemodes.match.input;
+
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/** Server-side validation for the typed decision contract. */
+public final class ExternalDecisionValidator {
+    private ExternalDecisionValidator() { }
+
+    public static void validateMissing(final ExternalDecisionRequest request) {
+        if (request == null) {
+            throw error(ExternalDecisionValidationException.Code.UNSUPPORTED_DECISION_PATH,
+                    "no authoritative decision request is open");
+        }
+        throw error(ExternalDecisionValidationException.Code.MISSING_RESPONSE,
+                "response envelope is missing");
+    }
+
+    public static List<String> validate(final ExternalDecisionRequest request,
+                                        final ExternalDecisionResponse response,
+                                        final long currentToken, final int currentActor,
+                                        final int currentPrincipal, final boolean consumed,
+                                        final boolean timedOut) {
+        if (request == null) {
+            throw error(ExternalDecisionValidationException.Code.UNSUPPORTED_DECISION_PATH,
+                    "no authoritative decision request is open");
+        }
+        if (timedOut) {
+            throw error(ExternalDecisionValidationException.Code.TIMEOUT, "decision deadline elapsed");
+        }
+        if (consumed) {
+            throw error(ExternalDecisionValidationException.Code.DECISION_CONSUMED, "decision was already consumed");
+        }
+        if (response == null) {
+            throw error(ExternalDecisionValidationException.Code.NULL_RESPONSE, "response is null");
+        }
+        if (response.getToken() != currentToken || response.getToken() != request.getToken()
+                || response.getDecisionId() != request.getDecisionId()) {
+            throw error(ExternalDecisionValidationException.Code.STALE_RESPONSE, "response does not match current request");
+        }
+        if (response.getActorId() != currentActor || response.getActorId() != request.getActorId()) {
+            throw error(ExternalDecisionValidationException.Code.WRONG_ACTOR, "response actor does not match current actor");
+        }
+        if (response.getPrincipalId() != currentPrincipal || response.getPrincipalId() != request.getPrincipalId()) {
+            throw error(ExternalDecisionValidationException.Code.WRONG_PRINCIPAL, "response principal does not match current principal");
+        }
+        if (!request.getResponseSchema().equals(response.getResponseSchema())
+                || response.getSelectedOptionIds() == null) {
+            throw error(ExternalDecisionValidationException.Code.MALFORMED_RESPONSE, "response schema or selection list is malformed");
+        }
+
+        final List<String> selected = response.getSelectedOptionIds();
+        final Set<String> legal = new HashSet<>();
+        for (ExternalDecisionRequest.Option option : request.getOptions()) {
+            legal.add(option.getOptionId());
+        }
+        final Set<String> seen = new HashSet<>();
+        for (String optionId : selected) {
+            if (optionId == null || optionId.isEmpty() || !legal.contains(optionId) || !seen.add(optionId)) {
+                throw error(ExternalDecisionValidationException.Code.ILLEGAL_OPTION,
+                        "selection is not a unique member of the authoritative option set");
+            }
+        }
+        if (response.isCancel()) {
+            if (!selected.isEmpty()) {
+                throw error(ExternalDecisionValidationException.Code.MALFORMED_RESPONSE,
+                        "cancel cannot include selections");
+            }
+            if (!request.isCancelAllowed()) {
+                throw error(ExternalDecisionValidationException.Code.CANCEL_NOT_ALLOWED, "cancel is not legal");
+            }
+        } else if (selected.size() < request.getMinimumSelection()
+                || selected.size() > request.getMaximumSelection()) {
+            throw error(ExternalDecisionValidationException.Code.INVALID_SELECTION_COUNT,
+                    "selection count is outside the authoritative bounds");
+        }
+        return selected;
+    }
+
+    private static ExternalDecisionValidationException error(final ExternalDecisionValidationException.Code code,
+                                                             final String message) {
+        return new ExternalDecisionValidationException(code, message);
+    }
+}
