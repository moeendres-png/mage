+    /**
+     * Apply an already validated external response to this authoritative input.
+     * The membership check is repeated here so a future caller cannot bypass the
+     * current input's exact option set between request creation and application.
+     */
+    public final void applyExternalSelection(final List<String> optionIds) {
+        if (isFinished()) {
+            throw new ExternalDecisionValidationException(ExternalDecisionValidationException.Code.STALE_RESPONSE,
+                    "input is already finished");
+        }
+        if (optionIds == null) {
+            throw new ExternalDecisionValidationException(ExternalDecisionValidationException.Code.NULL_RESPONSE,
+                    "selection list is null");
+        }
+        if (optionIds.size() < min || optionIds.size() > max) {
+            throw new ExternalDecisionValidationException(ExternalDecisionValidationException.Code.INVALID_SELECTION_COUNT,
+                    "selection count is outside the input bounds");
+        }
+        final Set<String> seen = new HashSet<>();
+        final List<T> resolved = new ArrayList<>();
+        for (String optionId : optionIds) {
+            if (optionId == null || !seen.add(optionId)) {
+                throw new ExternalDecisionValidationException(ExternalDecisionValidationException.Code.ILLEGAL_OPTION,
+                        "selection contains a null or duplicate option");
+            }
+            T matched = null;
+            for (T candidate : validChoices) {
+                if (ExternalDecisionRequest.optionIdFor(candidate).equals(optionId)) {
+                    matched = candidate;
+                    break;
+                }
+            }
+            if (matched == null) {
+                throw new ExternalDecisionValidationException(ExternalDecisionValidationException.Code.ILLEGAL_OPTION,
+                        "selection is not a member of validChoices");
+            }
+            resolved.add(matched);
+        }
+        selected.clear();
+        selected.addAll(resolved);
+        bCancelled = false;
+        stop();
+    }
+
+    public final void applyExternalCancel() {
+        if (isFinished()) {
+            throw new ExternalDecisionValidationException(ExternalDecisionValidationException.Code.STALE_RESPONSE,
+                    "input is already finished");
+        }
+        if (!allowCancel) {
+            throw new ExternalDecisionValidationException(ExternalDecisionValidationException.Code.CANCEL_NOT_ALLOWED,
+                    "cancel is not legal for this input");
+        }
+        bCancelled = true;
+        selected.clear();
+        stop();
+    }
