{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commander-simulator-next.decision-event.v1",
  "title": "Commander Simulator Next DecisionEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "decision_id", "token", "decision_kind", "actor", "principal", "response_status"],
  "properties": {
    "event_id": {"type": "integer", "minimum": 1},
    "decision_id": {"type": "integer", "minimum": 1},
    "token": {"type": "integer", "minimum": 1},
    "decision_kind": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "principal": {"type": "string", "minLength": 1},
    "response_status": {"type": "string", "enum": ["ACCEPTED", "REJECTED", "TIMEOUT", "UNSUPPORTED"]},
    "selected_option_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "error_code": {"type": "string"}
  }
}
