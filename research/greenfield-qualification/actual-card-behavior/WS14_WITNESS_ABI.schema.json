{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commander-simulator-next.invalid/ws14-witness-abi-v1.schema.json",
  "title": "Commander Simulator Next WS14 Atomic Primitive Witness ABI",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "witness_id", "primitive_ids", "primitive_exercise", "scenario_id", "forge_pin",
    "source_head", "source_tree", "initial_semantic_state_id", "decision_tape_ref", "rng_tape_ref",
    "state_assertions", "trace_sha256", "execution", "stdout_only", "official_rules_adjudication",
    "evidence_class", "run_job_artifact_refs"
  ],
  "properties": {
    "schema": {"const": "commander-simulator-next.atomic-primitive-witness.v1"},
    "witness_id": {"type": "string", "pattern": "^ws1[5-9]-[a-z0-9][a-z0-9._:-]{2,127}$"},
    "primitive_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^forge-primitive-v1:[0-9a-f]{32}$"}
    },
    "primitive_exercise": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["primitive_id", "trace_event_ids", "assertion_ids", "exercised"],
        "properties": {
          "primitive_id": {"type": "string", "pattern": "^forge-primitive-v1:[0-9a-f]{32}$"},
          "trace_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "exercised": {"const": true}
        }
      }
    },
    "scenario_id": {"type": "string", "minLength": 1},
    "forge_pin": {"const": "8c7e9afb8e6caee88644b94e25da5852e36f8928"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "initial_semantic_state_id": {"type": "string", "minLength": 1},
    "decision_tape_ref": {"type": ["string", "null"], "minLength": 1},
    "rng_tape_ref": {"type": ["string", "null"], "minLength": 1},
    "state_assertions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["assertion_id", "semantic_path", "expected", "result"],
        "properties": {
          "assertion_id": {"type": "string", "minLength": 1},
          "semantic_path": {"type": "string", "minLength": 1},
          "expected": {},
          "actual": {},
          "result": {"enum": ["PASS", "FAIL"]}
        }
      }
    },
    "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {"enum": ["PASS", "FAIL"]},
    "stdout_only": {"const": false},
    "official_rules_adjudication": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "rules_refs", "adjudication"],
      "properties": {
        "status": {"enum": ["EXTERNALLY_RULE_VALIDATED", "NOT_REQUIRED", "UNKNOWN"]},
        "rules_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "adjudication": {"type": ["string", "null"]}
      }
    },
    "evidence_class": {"enum": ["DIRECTLY_VERIFIED", "CODE_DERIVED", "TECHNICALLY_CONFORMANT", "EXTERNALLY_RULE_VALIDATED", "MODELED", "SYNTHETIC", "UNKNOWN"]},
    "run_job_artifact_refs": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "job_id", "artifact_id", "artifact_digest"],
      "properties": {
        "run_id": {"type": "integer", "minimum": 1},
        "job_id": {"type": "integer", "minimum": 1},
        "artifact_id": {"type": "integer", "minimum": 1},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"execution": {"const": "PASS"}}},
      "then": {
        "properties": {
          "state_assertions": {"items": {"properties": {"result": {"const": "PASS"}}}},
          "evidence_class": {"enum": ["TECHNICALLY_CONFORMANT", "EXTERNALLY_RULE_VALIDATED"]}
        }
      }
    }
  ]
}
