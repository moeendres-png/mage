{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commander-simulator-next.actual-card-witness.v2.1",
  "title": "WS33 successor-capable actual-card semantic witness ABI V2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "witness_id", "source_head", "source_tree",
    "qualification_source_head", "qualification_source_tree",
    "model_base_head", "model_base_tree", "ws26_manifest_sha256",
    "effective_model_sha256", "forge_pin", "runtime_overlay_manifest",
    "runtime_overlay_manifest_sha256", "patched_forge_digest",
    "execution_environment_identity", "oracle_identities",
    "parent_ws14_primitive_ids", "v2_path_ids", "owner_family",
    "initial_semantic_state", "final_semantic_state", "state_assertions",
    "primitive_exercise", "path_exercise", "decision_tape_ref",
    "rng_tape_ref", "observation_evidence_ref", "semantic_replay_evidence_ref",
    "execution", "trace_ref", "trace_sha256", "stdout_only",
    "rules_authority_refs", "evidence_class", "status"
  ],
  "properties": {
    "schema": {"const": "commander-simulator-next.actual-card-witness.v2.1"},
    "witness_id": {"type": "string", "minLength": 1},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "qualification_source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "qualification_source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "model_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "model_base_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ws26_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "forge_pin": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime_overlay_manifest": {"type": "string", "minLength": 1},
    "runtime_overlay_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "patched_forge_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_environment_identity": {
      "type": "object", "minProperties": 1,
      "required": ["runner_os", "java_version", "process_isolation"]
    },
    "oracle_identities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "parent_ws14_primitive_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^forge-primitive-v1:"}},
    "v2_path_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^forge-behavior-v2:"}},
    "owner_family": {"enum": ["ACTION_COST_DECISION", "TRIGGER_REPLACEMENT_ZONE_SBA", "CONTINUOUS_COPY_CONTROL", "COMBAT_COMMANDER", "HIDDEN_RNG_REPLAY"]},
    "initial_semantic_state": {"type": "object", "minProperties": 1},
    "final_semantic_state": {"type": "object", "minProperties": 1},
    "state_assertions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["assertion_id", "expected", "actual", "result"], "properties": {"assertion_id": {"type": "string", "minLength": 1}, "expected": {}, "actual": {}, "result": {"const": "PASS"}}, "additionalProperties": true}},
    "primitive_exercise": {"type": "array", "items": {"type": "object", "required": ["primitive_id", "exercised"], "properties": {"primitive_id": {"type": "string"}, "exercised": {"const": true}}, "additionalProperties": true}},
    "path_exercise": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["v2_path_id", "exercised", "trace_event_ids", "assertion_ids"], "properties": {"v2_path_id": {"type": "string"}, "exercised": {"const": true}, "trace_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "assertion_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "parent_ws14_primitive_id": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "decision_tape_ref": {"type": ["string", "null"]},
    "rng_tape_ref": {"type": ["string", "null"]},
    "observation_evidence_ref": {"type": ["string", "null"]},
    "semantic_replay_evidence_ref": {"type": ["string", "null"]},
    "execution": {"type": "object", "required": ["engine", "actual_rules_core_path", "authoritative_decision_boundary", "silent_fallbacks", "runtime_overlays_declared"], "properties": {"engine": {"const": "pinned-forge"}, "actual_rules_core_path": {"const": true}, "authoritative_decision_boundary": {"enum": ["USED", "NOT_REQUIRED"]}, "silent_fallbacks": {"const": 0}, "runtime_overlays_declared": {"const": true}}, "additionalProperties": true},
    "trace_ref": {"type": "string", "minLength": 1},
    "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stdout_only": {"const": false},
    "rules_authority_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_class": {"enum": ["DIRECTLY_VERIFIED", "CODE_DERIVED", "TECHNICALLY_CONFORMANT", "EXTERNALLY_RULE_VALIDATED", "MODELED", "SYNTHETIC", "UNKNOWN"]},
    "status": {"enum": ["PASS", "FAIL_CLOSED"]}
  }
}
